# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Clients may alternatively send BYOK via X-Gemini-Key header (not stored server-side).

# Optional override (default in code: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Optional: persist capsules elsewhere (e.g. Railway volume mount path)
# CAPSULES_DIR=/data/capsules

# Optional: extra CORS origins (comma-separated), if UI is hosted separately
# ALLOW_ORIGINS=https://your-app.up.railway.app
